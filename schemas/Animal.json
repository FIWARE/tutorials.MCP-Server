{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$schemaVersion": "0.0.2",
  "modelTags": "",
  "$id": "https://smart-data-models.github.io/dataModel.Agrifood/Animal/schema.json",
  "title": "Animal model IoF2020 ShareBeef UC",
  "description": "An observation of animal conditions at a certain place and time. This data model has been developed for the IoF2020 UC ShareBeef by UCO and SensoWave.",
  "type": "object",
  "allOf": [
    {
      "$ref": "https://smart-data-models.github.io/data-models/common-schema.json#/definitions/GSMA-Commons"
    },
    {
      "$ref": "https://smart-data-models.github.io/data-models/common-schema.json#/definitions/Location-Commons"
    },
    {
      "$ref": "https://smart-data-models.github.io/dataModel.Agrifood/agrifood-schema.json#/definitions/AgriFood-Commons"
    },
    {
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "Animal"
          ],
          "description": "NGSI Entity Type: It has to be Animal"
        },
        "heartRate": {
          "type": "number",
          "x-ngsi-type": "Property",
          "x-unitCode": "5K",
          "description": "Property. Heart rate of the animal. Units:'beats per minute' (UN/CEFACT 5K)"
        },
        "species": {
          "type": "string",
          "enum": [
            "beef cattle",
            "cow",
            "dairy cattle",
            "goat",
            "horse",
            "pig",
            "sheep"
          ],
          "x-ngsi-type": "Property",
          "description": "Property. Species to which the animal belongs. This enum can be increased. Enum:'cow, goat, horse, pig, sheep, dairy cattle, beef cattle'· Model:'https://schema.org/Text'"
        },
        "legalId": {
          "type": "string",
          "x-ngsi-type": "Property",
          "description": "Property. Legal ID of the animal"
        },
        "birthdate": {
          "type": "string",
          "format": "date-time",
          "x-ngsi-type": "Property",
          "description": "Property. Animal's birthdate. Model:'https://schema.org/DateTime'"
        },
        "sex": {
          "type": "string",
          "enum": [
            "female",
            "male"
          ],
          "x-ngsi-type": "VocabProperty",
          "description": "VocabProperty. Sex of the animal, held as a controlled-vocabulary term (mapped to https://schema.org/Male / https://schema.org/Female). Enum:'male, female'"
        },
        "breed": {
          "type": "string",
          "x-ngsi-type": "Property",
          "description": "Property. Breed of the animal"
        },
        "calvedBy": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 256,
              "pattern": "^[\\w\\-\\.\\{\\}\\$\\+\\*\\[\\]`|~^@!,:\\\\]+$",
              "description": "Identifier format of any NGSI entity"
            },
            {
              "type": "string",
              "format": "uri",
              "description": "Identifier format of any NGSI entity"
            }
          ],
          "x-ngsi-type": "Relationship",
          "description": "Relationship. Mother of the animal"
        },
        "siredBy": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 256,
              "pattern": "^[\\w\\-\\.\\{\\}\\$\\+\\*\\[\\]`|~^@!,:\\\\]+$",
              "description": "Identifier format of any NGSI entity"
            },
            {
              "type": "string",
              "format": "uri",
              "description": "Identifier format of any NGSI entity"
            }
          ],
          "x-ngsi-type": "Relationship",
          "description": "Relationship. Father of the animal"
        },
        "weight": {
          "type": "number",
          "x-ngsi-type": "Property",
          "x-unitCode": "KGM",
          "description": "Property. Model:'http://schema.org/Number'. The weight of the animal as a number. Units:'kg' (UN/CEFACT KGM)"
        },
        "ownedBy": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 256,
              "pattern": "^[\\w\\-\\.\\{\\}\\$\\+\\*\\[\\]`|~^@!,:\\\\]+$",
              "description": "Identifier format of any NGSI entity"
            },
            {
              "type": "string",
              "format": "uri",
              "description": "Identifier format of any NGSI entity"
            }
          ],
          "x-ngsi-type": "Relationship",
          "description": "Relationship. The owner of the animal"
        },
        "locatedAt": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 256,
              "pattern": "^[\\w\\-\\.\\{\\}\\$\\+\\*\\[\\]`|~^@!,:\\\\]+$",
              "description": "Identifier format of any NGSI entity"
            },
            {
              "type": "string",
              "format": "uri",
              "description": "Identifier format of any NGSI entity"
            }
          ],
          "x-ngsi-type": "Relationship",
          "description": "Relationship. The AgriParcel the animal is located at"
        },
        "phenologicalCondition": {
          "type": "string",
          "enum": [
            "femaleAdult",
            "femaleYoung",
            "grazingBaby",
            "lactatingBaby",
            "maleAdult",
            "maleYoung"
          ],
          "x-ngsi-type": "VocabProperty",
          "description": "VocabProperty. Phenological condition of the animal, held as a controlled-vocabulary term. Enum:'lactatingBaby, grazingBaby, maleAdult, femaleAdult, maleYoung, femaleYoung'"
        },
        "reproductiveCondition": {
          "type": "string",
          "enum": [
            "active",
            "inactive",
            "inCalf",
            "inHeat",
            "noStatus"
          ],
          "x-ngsi-type": "VocabProperty",
          "description": "VocabProperty. Reproductive condition of the animal, held as a controlled-vocabulary term. Enum:'noStatus, inactive, inCalf, inHeat, active'"
        },
        "healthCondition": {
          "type": "string",
          "enum": [
            "healthy",
            "inTreatment",
            "sick"
          ],
          "x-ngsi-type": "VocabProperty",
          "description": "VocabProperty. Health condition of the animal, held as a controlled-vocabulary term. Enum:'healthy, sick, inTreatment'"
        },
        "fedWith": {
          "type": "string",
          "x-ngsi-type": "Property",
          "description": "Property. Food used for the animal"
        },
        "welfareCondition": {
          "type": "string",
          "enum": [
            "issue",
            "adequate"
          ],
          "x-ngsi-type": "VocabProperty",
          "description": "VocabProperty. Indicator of the animal welfare, held as a controlled-vocabulary term. Enum:'issue, adequate'"
        }
      }
    }
  ],
  "required": [
    "id",
    "type",
    "species",
    "legalId",
    "sex"
  ]
}
