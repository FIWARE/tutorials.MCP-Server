# Chat-bot config
PORT=3005
MCP_URL=http://localhost:3003/mcp

# Default provider: anthropic | openai | ollama | gemini
PROVIDER=anthropic

# A provider is enabled when its API key (or, for Ollama, its base URL) is set.
# The *_BASE_URL values below are the SDK defaults — override only to route
# through a proxy or gateway.

# Anthropic (baseline, known-good)
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com
ANTHROPIC_MODEL=claude-sonnet-5

# OpenAI
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o

# Ollama — OpenAI-compatible endpoint; run Ollama on the host, not in Docker on macOS
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=qwen2.5:3b

# Gemini — via its OpenAI-compatible endpoint
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
GEMINI_MODEL=gemini-2.5-flash
