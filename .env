# Project name
COMPOSE_PROJECT_NAME=fiware
EXPOSED_PORT=1026

# Orion variables
ORION_LD_PORT=1026
ORION_LD_VERSION=1.13.0-PRE-1876 
#1.12.0

# Mintaka variables
MINTAKA_PORT=8080
MINTAKA_VERSION=0.6.18
TIMESCALE_VERSION=1.7.5-pg12
TIMESCALE_PORT=5432

# Scorpio variables
SCORPIO_PORT=9090
SCORPIO_VERSION=5.0.9

# Stellio variables
STELLIO_DOCKER_TAG=2.24.1
STELLIO_PORT=8080
STELLIO_TIMESCALE_POSTGIS=16-2.16.0-3.3

# Coraine variables
CORAINE_PORT=1026
CORAINE_VERSION=0.4.0

# Curl variables
CURL_VERSION=8.6.0

# MongoDB variables
MONGO_DB_PORT=27017
MONGO_DB_VERSION=6.0

# IoT Agent JSON Variables
JSON_VERSION=3.14.0-distroless
IOTA_NORTH_PORT=4041
IOTA_SOUTH_PORT=7896

# Tutorial variables
TUTORIAL_APP_PORT=3000
TUTORIAL_DUMMY_DEVICE_PORT=3001

# MCP Server variables
MCP_SERVER_PORT=3003

# Chat-bot variables
CHAT_BOT_PORT=3006
SESSION_SECRET=change-me-in-production

# Keycloak variables
KEYCLOAK_VERSION=24.0.1
KEYCLOAK_PORT=3005

# PostgreSQL variables
POSTGRES_VERSION=15

# APISIX variables
APISIX_PORT=9080
MCP_PROXY_PORT=1030

# OAuth variables
OIDC_REALM=farm-management
OIDC_CLIENT_ID=ngsi-ld-farm
OIDC_CLIENT_SECRET=1234
MCP_CLIENT_ID=ngsi-ld-mcp-server
MCP_CLIENT_SECRET=1234


# Chat-bot LLM providers: fill in only the keys you use.
# A provider is enabled when its API key (or, for Ollama, its base URL) is set.
# Supported: anthropic, openai, gemini, groq, openrouter, nvidia, cohere, ollama.
# 
# Run ./check-models to verify keys and see which model each provider would use.
CHAT_BOT_PROVIDER=anthropic
# Anthropic key: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com
ANTHROPIC_MODEL=
# OpenAI key: https://platform.openai.com/api-keys
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o
# Ollama can be run as an additional docker container, but it is memory intensive
# docker-compose/ollama.yml overrides this to http://ollama:11434/v1 (in-network instance).
OLLAMA_BASE_URL=http://host.docker.internal:11434/v1
OLLAMA_MODEL=qwen2.5:3b
OLLAMA_VERSION=0.5.7
# Gemini key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
GEMINI_MODEL=

# Groq key: https://console.groq.com/keys
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=

# OpenRouter key: https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=

# NVIDIA NIM key: https://build.nvidia.com
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=

# Cohere key: https://dashboard.cohere.com/api-keys
COHERE_API_KEY=
COHERE_BASE_URL=https://api.cohere.ai/compatibility/v1
COHERE_MODEL=

# QuantumLeap Variables
QUANTUMLEAP_VERSION=1.0.0
QUANTUMLEAP_PORT=8668

# CrateDB Version
#CRATE_VERSION=4.8.1
CRATE_VERSION=5.8.2

# RedisDB Version
REDIS_PORT=6379
REDIS_VERSION=6

PIG_COUNT=4
COW_COUNT=4